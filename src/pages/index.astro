---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Bluffs — Overlooking Weiss Lake | Cedar Bluff, Alabama"
  description="A private gated community offering panoramic lake views, nature, and peaceful living in Northeast Alabama. Homesites starting in the $30s, homes from the mid-$500s."
>

  <!-- HERO -->
  <section class="hero" aria-label="Welcome to The Bluffs">
    <div class="hero-media">
      <img
        src="/assets/images/hero.jpg"
        alt="Panoramic view of Weiss Lake from The Bluffs community"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="hero-overlay">
        <div class="hero-content">
          <h1>Welcome to The Bluffs</h1>
          <p class="hero-subhead">A private gated community offering panoramic lake views, nature, and peaceful living in Northeast Alabama.</p>
          <a href="/contact" class="btn btn-light">Contact Us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- INTRO -->
  <section class="section intro-section">
    <div class="container-narrow text-center">
      <p class="intro-text">
        Located on a mountain peninsula extending into Weiss Lake, The Bluffs features elevated homesites designed to maximize views, privacy, and natural surroundings. The community's layout emphasizes space, quiet living, and a strong connection to the lake and landscape. In fact, <strong>every homesite has a water view</strong>, with a view of the surrounding Piedmont Mountain Range in the background.
      </p>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section-sm video-section" aria-label="Community walkthrough video">
    <div class="container">
      <div class="video-wrapper">
        <iframe
          src="https://www.youtube.com/embed/U709m7_CYrk?si=hlEO61lBist36rMS"
          title="The Bluffs community walkthrough video"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- AVAILABLE HOMESITES BANNER -->
  <section class="available-banner" aria-label="Available Homesites">
    <div class="available-banner-img">
      <img
        src="/assets/images/homesites-banner.jpg"
        alt="Autumn orchard and community landscape at The Bluffs"
        width="1920"
        height="600"
        loading="lazy"
      />
      <div class="available-banner-overlay">
        <div class="available-banner-content">
          <h2>Available Homesites</h2>
          <a href="/homesites" class="btn btn-light">Learn More</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
  }

  .hero-media {
    position: relative;
    height: calc(100vh - var(--nav-height));
    min-height: 520px;
    max-height: 900px;
    overflow: hidden;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(28, 28, 26, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-8);
  }

  .hero-content {
    max-width: 700px;
  }

  .hero-content h1 {
    color: var(--color-white);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
    font-weight: 400;
    text-shadow: 0 2px 12px rgba(0,0,0,0.35);
    margin-bottom: var(--space-4);
  }

  .hero-subhead {
    color: rgba(255,255,255,0.9);
    font-family: var(--font-body);
    font-size: clamp(var(--text-base), 2vw, var(--text-md));
    margin-bottom: var(--space-8);
    text-shadow: 0 1px 6px rgba(0,0,0,0.3);
    line-height: 1.6;
  }

  /* Intro */
  .intro-section {
    border-bottom: 1px solid var(--color-olive-light);
  }

  .intro-text {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: 1.8;
    color: var(--color-charcoal-mid);
    margin: 0;
  }

  /* Video */
  .video-section {
    background: var(--color-cream);
    padding: var(--space-16) 0;
  }

  .video-wrapper {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    padding-bottom: min(56.25%, 540px);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Available homesites banner */
  .available-banner-img {
    position: relative;
    height: 480px;
    overflow: hidden;
  }

  .available-banner-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .available-banner-overlay {
    position: absolute;
    inset: 0;
    background: rgba(28, 28, 26, 0.42);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex-direction: column;
    gap: var(--space-6);
  }

  .available-banner-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .available-banner-content h2 {
    color: var(--color-white);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
  }

  @media (max-width: 600px) {
    .hero-media {
      height: 70vh;
    }

    .available-banner-img {
      height: 320px;
    }
  }
</style>
