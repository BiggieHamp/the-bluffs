---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Our Vision | The Bluffs — Overlooking Weiss Lake"
  description="The Bluffs is a private gated community on a mountain peninsula extending into Weiss Lake, offering homesites with panoramic water and mountain views."
  image="/assets/images/pages/vision-sunset.jpg"
>

  <!-- HERO -->
  <div class="page-hero">
    <img
      src="/assets/images/pages/vision-sunset.jpg"
      alt="Sunset over the treeline at The Bluffs, Weiss Lake"
      width="1920"
      height="800"
      fetchpriority="high"
    />
    <div class="page-hero-overlay">
      <h1 class="page-hero-title">Our Vision For This Unique Weiss Lake Property</h1>
    </div>
  </div>

  <!-- INTRO BLOCK: 3-column (heading / photo / paragraph) -->
  <section class="section intro-block">
    <div class="container">
      <div class="vision-intro">
        <div class="vision-intro-heading">
          <h2>A Community Designed Around Nature</h2>
        </div>
        <div class="vision-intro-img">
          <img
            src="/assets/images/pages/vision-sunset.jpg"
            alt="Golden sunset light over the mountain treeline at The Bluffs"
            width="600"
            height="400"
            loading="lazy"
          />
        </div>
        <div class="vision-intro-text prose">
          <p>
            The Bluffs is a large gated residential development located in Cedar Bluff, Alabama,
            in the foothills of the Appalachian Mountain Range. The development is actually on a
            mountain peninsula which extends into the 30,000 acre, 52 mile-long Weiss Lake.
          </p>
          <p>
            This unusual location allows the development of each homesite such that all have a
            water view, with most also having a view of the surrounding mountains.
          </p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider" style="max-width: var(--max-width); margin: 0 auto;" />

  <!-- SUSTAINABLE LIVING -->
  <section class="section sustainable-section">
    <div class="container-narrow text-center">
      <p class="sustainable-label"><em>Sustainable Living</em></p>
      <h2>A Different Way to Live</h2>
      <p class="sustainable-intro">
        From the beginning, The Bluffs has been designed with a philosophy of sustainable,
        community-focused living — thoughtfully planned so that residents can enjoy the land
        as much as the view.
      </p>
    </div>

    <div class="container">
      <div class="amenity-grid">

        <div class="amenity-card">
          <div class="amenity-icon" aria-hidden="true">&#127807;</div>
          <h3>Community Gardens &amp; Orchard</h3>
          <p>
            A restored community orchard with 28 varieties of fruit — apple, peach, plum,
            pear, and fig trees, along with pecan, blueberry, grape, and muscadine — fed
            by spring-supplied irrigation and available to all residents.
          </p>
        </div>

        <div class="amenity-card">
          <div class="amenity-icon" aria-hidden="true">&#127959;</div>
          <h3>Trails &amp; Open Space</h3>
          <p>
            Nearly a dozen miles of walking, biking, horseback, and 4-wheeler trails wind
            through the community's forested mountain terrain, connecting homesites with the
            lake and open ridge-top views.
          </p>
        </div>

        <div class="amenity-card">
          <div class="amenity-icon" aria-hidden="true">&#9975;</div>
          <h3>Private Lake Access</h3>
          <p>
            Gated, private lakeside access with picnic grounds, covered docks, and shoreline
            areas exclusively for community residents and their guests.
          </p>
        </div>

        <div class="amenity-card">
          <div class="amenity-icon" aria-hidden="true">&#127907;</div>
          <h3>Private Fishing Lakes</h3>
          <p>
            In addition to Weiss Lake, the community includes private fishing lakes stocked
            and maintained for resident use — a quiet retreat within the retreat.
          </p>
        </div>

        <div class="amenity-card">
          <div class="amenity-icon" aria-hidden="true">&#127968;</div>
          <h3>Quality Building Guidelines</h3>
          <p>
            HOA covenants and building guidelines protect the character of the community
            and the investment of every homeowner — without being overly restrictive about
            architectural style.
          </p>
        </div>

        <div class="amenity-card">
          <div class="amenity-icon" aria-hidden="true">&#127753;</div>
          <h3>Natural Setting, Preserved</h3>
          <p>
            The layout of The Bluffs prioritizes open space, mature hardwoods, and long
            sight-lines over density — ensuring privacy and natural beauty for every lot.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm cta-band">
    <div class="container text-center">
      <p>Ready to see it for yourself?</p>
      <div class="cta-buttons">
        <a href="/homesites" class="btn btn-primary">View Available Homesites</a>
        <a href="/contact"   class="btn btn-outline">Contact Us</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Intro 3-column */
  .vision-intro {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  .vision-intro-heading h2 {
    font-size: var(--text-2xl);
    line-height: 1.25;
  }

  .vision-intro-img img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* Sustainable Living */
  .sustainable-label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-olive);
    margin-bottom: var(--space-2);
  }

  .sustainable-intro {
    font-size: var(--text-md);
    color: var(--color-charcoal-mid);
    margin-top: var(--space-4);
    margin-bottom: 0;
  }

  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-12);
  }

  .amenity-card {
    padding: var(--space-6);
    border: 1px solid var(--color-olive-light);
    border-radius: var(--radius);
  }

  .amenity-icon {
    font-size: 2rem;
    margin-bottom: var(--space-3);
    line-height: 1;
  }

  .amenity-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }

  .amenity-card p {
    font-size: var(--text-sm);
    color: var(--color-charcoal-mid);
    line-height: 1.7;
    margin: 0;
  }

  /* CTA band */
  .cta-band {
    background: var(--color-cream-dark);
    border-top: 1px solid var(--color-olive-light);
  }

  .cta-band p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .vision-intro {
      grid-template-columns: 1fr;
    }

    .vision-intro-img img {
      height: 220px;
    }

    .amenity-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .amenity-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
