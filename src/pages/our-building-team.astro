---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Our Building Team | The Bluffs — Overlooking Weiss Lake"
  description="Chappell Construction Group builds custom homes at The Bluffs. Wade Chappell brings Georgia Tech engineering credentials and decades of Southeast construction experience."
>

  <!-- PAGE HEADER -->
  <section class="section page-header">
    <div class="container-narrow text-center">
      <h1>Our Building Team</h1>
    </div>
  </section>

  <!-- CHAPPELL SECTION -->
  <section class="section-sm builder-section">
    <div class="container">
      <div class="builder-block">

        <div class="builder-logo-col">
          <img
            src="/assets/images/pages/chappell-logo.jpg"
            alt="Chappell Construction Group logo"
            width="320"
            height="200"
            loading="lazy"
          />
        </div>

        <div class="builder-content prose">
          <h2>Chappell Construction</h2>
          <p>
            Wade Chappell leads Chappell Construction Group, bringing a Georgia Tech engineering
            education — including a Building Construction certificate — to every project he
            undertakes. With decades of experience across the Southeast building custom homes,
            medical facilities, retail, and office buildings, Wade and his team deliver a
            level of craftsmanship and accountability that's rare in custom residential construction.
          </p>
          <p>
            Chappell Construction has already completed homes within The Bluffs and currently
            has additional homes underway in the community. They are the trusted builder partner
            for The Bluffs and are intimately familiar with the community's topography, building
            guidelines, and architectural vision.
          </p>
          <p>
            Chappell Construction Group is also an affiliated member of the
            <strong>Southern Living Custom Builders Program</strong>, a distinction that reflects
            their commitment to quality design and construction standards.
          </p>

          <div class="builder-contact">
            <p class="builder-contact-label">Contact Wade Chappell</p>
            <p>
              <a href="tel:+14049649554">(404) 964-9554</a>
            </p>
            <p>
              <a href="mailto:wade@chappellcg.com">wade@chappellcg.com</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- DIVIDER / CTA -->
  <section class="section-sm cta-band">
    <div class="container text-center">
      <p>Ready to discuss building your home at The Bluffs?</p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-primary">Get in Touch</a>
        <a href="/homesites" class="btn btn-outline">View Available Lots</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    border-bottom: 1px solid var(--color-olive-light);
    padding-bottom: var(--space-10);
  }

  .builder-block {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  .builder-logo-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: sticky;
    top: calc(var(--nav-height) + var(--space-8));
  }

  .builder-logo-col img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-olive-light);
    padding: var(--space-6);
    background: var(--color-white);
  }

  .builder-content h2 {
    margin-bottom: var(--space-6);
  }

  .builder-content.prose p {
    color: var(--color-charcoal-mid);
    line-height: 1.8;
    margin-bottom: var(--space-5);
  }

  .builder-contact {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border-left: 3px solid var(--color-olive);
    background: var(--color-cream-dark);
  }

  .builder-contact-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-olive);
    margin-bottom: var(--space-2);
  }

  .builder-contact p {
    margin-bottom: var(--space-1);
  }

  .builder-contact a {
    color: var(--color-charcoal);
    text-decoration: none;
    transition: color var(--transition);
  }

  .builder-contact a:hover {
    color: var(--color-olive);
  }

  /* CTA band */
  .cta-band {
    background: var(--color-cream-dark);
    border-top: 1px solid var(--color-olive-light);
  }

  .cta-band p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .builder-block {
      grid-template-columns: 1fr;
    }

    .builder-logo-col {
      position: static;
      max-width: 280px;
      margin: 0 auto;
    }
  }
</style>
