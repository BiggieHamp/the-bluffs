---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import homesitesData from '../data/homesites.json';

const phase1  = homesitesData.filter(l => l.phase === 1);
const phase2  = homesitesData.filter(l => l.phase === 2);
const phase2a = phase2.slice(0, 8);   // Lots 205–219
const phase2b = phase2.slice(8);      // Lots 220–292
const phase3  = homesitesData.filter(l => l.phase === 3);
---

<BaseLayout
  title="Available Homes & Homesites | The Bluffs — Overlooking Weiss Lake"
  description="Available lots at The Bluffs on Weiss Lake, Cedar Bluff, Alabama. Homesites from the $30s across Phase 1–3. Custom homes starting in the mid-$500s."
  image="/assets/images/pages/plat-map.jpg"
>

  <!-- PAGE HEADER -->
  <section class="section page-header">
    <div class="container-narrow text-center">
      <h1>Available Homes &amp; Homesites</h1>
      <p class="page-intro">
        Homesites available across three phases, each with water views and access to
        the full community. Custom homes starting in the mid-$500s.
      </p>
    </div>
  </section>

  <!-- PLAT MAP -->
  <section class="section-sm plat-section">
    <div class="container">
      <h2 class="section-heading">Property Map</h2>
      <div class="plat-wrap">
        <div class="plat-map-container">
          <img
            src="/assets/images/pages/plat-map.jpg"
            alt="Plat map of The Bluffs, showing Phase 1–3 lots on the Weiss Lake peninsula, Cedar Bluff, Cherokee County, Alabama"
            width="830"
            height="1170"
            loading="lazy"
            class="plat-img"
          />
          <div class="map-rect">
            <div class="key-inner">

              <img src="/assets/images/logo.jpg" alt="The Bluffs" class="key-logo" />
              <p class="key-note"><strong>Note:</strong> All Available Lots Listed Below (Shaded on Plat). All Others Sold. Price And Availability Subject To Change Without Prior Notice.</p>

              <div class="key-tables">

                <div class="key-col">
                  <!-- Phase 1 -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 1</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase1.map((lot, i) => (
                        <tr class={i % 2 === 0 ? 'row-white' : 'row-yellow'}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{lot.acres}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  <!-- Phase 2 -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 2</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase2a.map((lot, i) => (
                        <tr class={i % 2 === 0 ? 'row-white' : 'row-yellow'}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{lot.acres}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <div class="key-col">
                  <!-- Phase 2 Continued -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 2 - Continued</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase2b.map((lot, i) => (
                        <tr class={i % 2 === 0 ? 'row-white' : 'row-yellow'}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{lot.acres}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  <!-- Phase 3 -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 3</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase3.map((lot, i) => (
                        <tr class={i % 2 === 0 ? 'row-white' : 'row-yellow'}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{lot.acres}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

              </div><!-- /key-tables -->

              <p class="key-footer">* Acreage Approximate, Subject To Final Survey. &nbsp;&nbsp; Revised 10-2025</p>

            </div><!-- /key-inner -->
          </div>
        </div>
        <p class="plat-caption">
          The Bluffs — Overlooking Weiss Lake, Cedar Bluff, Cherokee County, Alabama.
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" style="max-width: var(--max-width); margin: 0 auto;" />

  <!-- PRICING TABLE -->
  <section class="section-sm pricing-section">
    <div class="container">
      <h2 class="section-heading">Available Lots &amp; Pricing</h2>
      <p class="pricing-intro">
        To update lot status (available, sold, under contract) or pricing, edit
        <code>src/data/homesites.json</code> — no other changes needed.
      </p>
      <PricingTable />
    </div>
  </section>

  <hr class="divider" style="max-width: var(--max-width); margin: 0 auto;" />

  <!-- LISTING AGENTS -->
  <section class="section-sm agents-section">
    <div class="container">
      <div class="agents-block">
        <div class="agents-text">
          <h2>Listed With</h2>
          <p class="agents-firm">Maximum One Alabama Realtors</p>
          <p>Cedar Bluff, Alabama</p>
        </div>
        <div class="agents-list">
          <div class="agent-card">
            <p class="agent-name">Sandy Cole, Realtor</p>
            <p><a href="tel:+17705005159">(770) 500-5159</a></p>
          </div>
          <div class="agent-card">
            <p class="agent-name">Jennifer Black, Realtor</p>
            <p><a href="tel:+14702146196">(470) 214-6196</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm cta-band">
    <div class="container text-center">
      <p>Ready to find your lot?</p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-primary">Contact Us</a>
        <a href="/gallery/lots-5-6" class="btn btn-outline">View Lots 5 &amp; 6 Photos</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    border-bottom: 1px solid var(--color-olive-light);
    padding-bottom: var(--space-10);
  }

  .page-header h1 {
    margin-bottom: var(--space-4);
  }

  .page-intro {
    font-size: var(--text-md);
    color: var(--color-charcoal-mid);
    margin: 0;
  }

  .section-heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
    color: var(--color-charcoal);
  }

  /* Plat map */
  .plat-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .plat-map-container {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--color-olive-light);
    overflow: hidden;
    line-height: 0;
  }

  .plat-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-rect {
    position: absolute;
    top:    59.51%;
    left:   3.36%;
    width:  41.24%;
    height: 40.49%;
    background: #ffffff;
    overflow: hidden;
  }

  /* key-inner is the container query anchor so cqw = map-rect width */
  .key-inner {
    container-type: inline-size;
    padding: 1.5cqw 1.5cqw 1cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2cqw;
    overflow: hidden;
    height: 100%;
  }

  .key-logo {
    width: 62%;
    height: auto;
    display: block;
    flex-shrink: 0;
  }

  .key-note {
    font-size: 2.8cqw;
    color: #1a1a1a !important;
    text-align: center;
    line-height: 1.3;
    flex-shrink: 0;
    margin-bottom: 0;
  }

  .key-note strong,
  .key-note * {
    color: #1a1a1a !important;
  }

  .key-tables {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5cqw;
    width: 100%;
    flex-shrink: 0;
  }

  .key-col {
    display: flex;
    flex-direction: column;
    gap: 1.5cqw;
  }

  .key-tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 3.5cqw;
    line-height: 1.2;
    border: 1px solid #aac0d0;
  }

  .key-phase-hd {
    background: #c8dce8;
    color: #1a1a1a;
    font-size: 3.8cqw;
    font-weight: 700;
    text-align: center;
    padding: 0.6cqw 0.8cqw;
    border-bottom: 1px solid #aac0d0;
    line-height: 1.2;
  }

  .key-col-hds th {
    background: #e4eef5;
    color: #cc2200;
    font-size: 3.2cqw;
    font-weight: 700;
    text-align: left;
    padding: 0.5cqw 0.8cqw;
    border-bottom: 1px solid #aac0d0;
    line-height: 1.2;
  }

  .key-tbl tbody tr td {
    padding: 0.5cqw 0.8cqw;
    color: #1a1a1a;
    text-align: left;
    line-height: 1.2;
  }

  .row-white { background: #ffffff; }
  .row-yellow { background: #fffff0; }

  .key-footer {
    font-size: 2.8cqw;
    color: #444;
    text-align: center;
    width: 100%;
    flex-shrink: 0;
    margin-top: 0.5cqw;
  }

  .plat-caption {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    text-align: center;
    margin: 0;
  }

  /* Pricing section */
  .pricing-intro {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    margin-bottom: var(--space-6);
  }

  .pricing-intro code {
    font-size: var(--text-xs);
    background: var(--color-cream-dark);
    padding: 2px 6px;
    border-radius: 2px;
    color: var(--color-charcoal-mid);
  }

  /* Agents */
  .agents-block {
    display: flex;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .agents-text h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .agents-firm {
    font-weight: 500;
    font-size: var(--text-md);
    color: var(--color-charcoal);
    margin-bottom: var(--space-1);
  }

  .agents-text p {
    color: var(--color-charcoal-mid);
    font-size: var(--text-sm);
    margin: 0;
  }

  .agents-list {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .agent-card {
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-olive-light);
    border-radius: var(--radius);
    background: var(--color-cream-dark);
  }

  .agent-name {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-charcoal);
    margin-bottom: var(--space-1);
  }

  .agent-card a {
    font-size: var(--text-sm);
    color: var(--color-charcoal-mid);
    text-decoration: none;
    transition: color var(--transition);
  }

  .agent-card a:hover {
    color: var(--color-olive);
  }

  /* CTA band */
  .cta-band {
    background: var(--color-cream-dark);
    border-top: 1px solid var(--color-olive-light);
  }

  .cta-band p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .agents-block {
      flex-direction: column;
      gap: var(--space-8);
    }
  }
</style>
