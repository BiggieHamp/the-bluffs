---
import BaseLayout from '../layouts/BaseLayout.astro';
import homesitesData from '../data/homesites.json';

const phase1  = homesitesData.filter(l => l.phase === 1);
const phase2  = homesitesData.filter(l => l.phase === 2);
const phase2a = phase2.slice(0, 8);   // Lots 205–219
const phase2b = phase2.slice(8);      // Lots 220–292
const phase3  = homesitesData.filter(l => l.phase === 3);
---

<BaseLayout
  title="Available Homes & Homesites | The Bluffs — Overlooking Weiss Lake"
  description="Available lots at The Bluffs on Weiss Lake, Cedar Bluff, Alabama. Homesites from the $30s across Phase 1–3. Custom homes starting in the mid-$500s."
  image="/assets/images/pages/plat-map.jpg"
>

  <!-- PAGE HEADER -->
  <section class="section page-header">
    <div class="container-narrow text-center">
      <h1>Available Homes &amp; Homesites</h1>
      <p class="page-intro">
        Homesites available across three phases, each with water views and access to
        the full community. Custom homes starting in the mid-$500s.
        Browse the property map below - click any lot label in the key to view photos and details.
      </p>
    </div>
  </section>

  <!-- PLAT MAP -->
  <section class="section-sm plat-section">
    <div class="container">
      <h2 class="section-heading">Property Map</h2>
      <div class="plat-wrap">
        <div class="plat-map-container">
          <img
            src="/assets/images/pages/plat-map.jpg"
            alt="Plat map of The Bluffs, showing Phase 1–3 lots on the Weiss Lake peninsula, Cedar Bluff, Cherokee County, Alabama"
            width="830"
            height="1170"
            loading="lazy"
            class="plat-img"
          />
          <div class="map-rect">
            <div class="key-inner">

              <img src="/assets/images/logo-transparent.png" alt="The Bluffs" class="key-logo" />
              <p class="key-note"><em>Note:</em> All Available Lots Listed Below (Shaded on Plat). All Others Sold. Price And Availability Subject To Change Without Prior Notice. <strong>Click Any Lot To View Photos &amp; Details.</strong></p>

              <div class="key-tables">

                <div class="key-col">
                  <!-- Phase 1 -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 1</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase1.map((lot, i) => (
                        <tr class={`lot-row ${i % 2 === 0 ? 'row-white' : 'row-yellow'}`} data-lot-id={lot.id} data-status={lot.status}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{Number(lot.acres).toFixed(2)}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  <!-- Phase 2 -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 2</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase2a.map((lot, i) => (
                        <tr class={`lot-row ${i % 2 === 0 ? 'row-white' : 'row-yellow'}`} data-lot-id={lot.id} data-status={lot.status}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{Number(lot.acres).toFixed(2)}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

                <div class="key-col">
                  <!-- Phase 2 Continued -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 2 - Continued</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase2b.map((lot, i) => (
                        <tr class={`lot-row ${i % 2 === 0 ? 'row-white' : 'row-yellow'}`} data-lot-id={lot.id} data-status={lot.status}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{Number(lot.acres).toFixed(2)}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>

                  <!-- Phase 3 -->
                  <table class="key-tbl">
                    <thead>
                      <tr><th colspan="3" class="key-phase-hd">Phase 3</th></tr>
                      <tr class="key-col-hds"><th>Lot#</th><th>Acreage</th><th>Price</th></tr>
                    </thead>
                    <tbody>
                      {phase3.map((lot, i) => (
                        <tr class={`lot-row ${i % 2 === 0 ? 'row-white' : 'row-yellow'}`} data-lot-id={lot.id} data-status={lot.status}>
                          <td>{lot.lot.replace('Lot ', '')}</td>
                          <td>{Number(lot.acres).toFixed(2)}</td>
                          <td>${lot.price.toLocaleString()}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>

              </div><!-- /key-tables -->

              <p class="key-footer">* Acreage Approximate, Subject To Final Survey. &nbsp;&nbsp; Revised 10-2025</p>

            </div><!-- /key-inner -->
          </div>
        </div>
        <p class="plat-caption">
          The Bluffs — Overlooking Weiss Lake, Cedar Bluff, Cherokee County, Alabama.
        </p>
      </div>
    </div>
  </section>

  <hr class="divider" style="max-width: var(--max-width); margin: 0 auto;" />

  <!-- LISTING AGENTS -->
  <section class="section-sm agents-section">
    <div class="container">
      <div class="agents-block">
        <div class="agents-text">
          <h2>Listed With</h2>
          <p class="agents-firm">Maximum One Alabama Realtors</p>
          <p>Cedar Bluff, Alabama</p>
        </div>
        <div class="agents-list">
          <div class="agent-card">
            <p class="agent-name">Sandy Cole, Realtor</p>
            <p><a href="tel:+17705005159">(770) 500-5159</a></p>
          </div>
          <div class="agent-card">
            <p class="agent-name">Jennifer Black, Realtor</p>
            <p><a href="tel:+14702146196">(470) 214-6196</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm cta-band">
    <div class="container text-center">
      <p>Ready to find your lot?</p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-primary">Contact Us</a>
      </div>
    </div>
  </section>

  <!-- LIGHTBOX -->
  <div class="lot-lightbox" id="lot-lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="lot-lightbox-close" id="lightbox-close" aria-label="Close photo viewer">&#215;</button>
    <div class="lot-lightbox-img-wrap">
      <button class="lot-lightbox-nav prev" id="lightbox-prev" aria-label="Previous photo">&#8249;</button>
      <img id="lightbox-img" src="" alt="" />
      <button class="lot-lightbox-nav next" id="lightbox-next" aria-label="Next photo">&#8250;</button>
    </div>
    <p class="lot-lightbox-label" id="lightbox-label"></p>
    <p class="lot-lightbox-counter" id="lightbox-counter"></p>
  </div>

  <!-- LOT DETAIL PANEL -->
  <aside class="lot-panel" id="lot-panel" aria-hidden="true" aria-label="Lot details">
    <div class="lot-panel-header">
      <div>
        <p class="lot-panel-phase" id="panel-phase"></p>
        <h3 class="lot-panel-title" id="panel-title"></h3>
        <span class="lot-sold-badge" id="panel-sold-badge" style="display:none">SOLD</span>
      </div>
      <button class="lot-panel-close" id="panel-close" aria-label="Close lot details">&#215;</button>
    </div>
    <div class="lot-panel-body">
      <div class="lot-panel-photos" id="panel-photos"></div>
      <div class="lot-panel-stats" id="panel-stats"></div>
      <p class="lot-panel-desc" id="panel-desc"></p>
      <a class="lot-panel-cta" id="panel-cta" href="/contact">Contact Us About This Lot</a>
    </div>
  </aside>
  <div class="lot-panel-backdrop" id="lot-panel-backdrop"></div>

</BaseLayout>

<style>
  .page-header {
    border-bottom: 1px solid var(--color-olive-light);
    padding-bottom: var(--space-10);
  }

  .page-header h1 {
    margin-bottom: var(--space-4);
  }

  .page-intro {
    font-size: var(--text-md);
    color: var(--color-charcoal-mid);
    margin: 0;
  }

  .section-heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
    color: var(--color-charcoal);
  }

  /* Plat map */
  .plat-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .plat-map-container {
    position: relative;
    border-radius: var(--radius);
    border: 1px solid var(--color-olive-light);
    overflow: hidden;
    line-height: 0;
  }

  .plat-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-rect {
    position: absolute;
    top:    59.51%;
    left:   3.36%;
    width:  41.24%;
    height: 37.8%;
    background: #ffffff;
    overflow: hidden;
  }

  /* key-inner is the container query anchor so cqw = map-rect width */
  .key-inner {
    container-type: inline-size;
    padding: 0.8cqw 1.5cqw 0.8cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6cqw;
    overflow: hidden;
    height: 100%;
  }

  .key-logo {
    width: 70%;
    height: auto;
    display: block;
    flex-shrink: 0;
  }

  .key-note {
    font-size: 2.8cqw;
    color: #1a1a1a !important;
    text-align: center;
    line-height: 1.3;
    flex-shrink: 0;
    margin-bottom: 0;
  }

  .key-note strong,
  .key-note * {
    color: #1a1a1a !important;
  }


  .key-tables {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5cqw;
    width: 100%;
    flex-shrink: 0;
  }

  .key-col {
    display: flex;
    flex-direction: column;
    gap: 1.5cqw;
  }

  .key-tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: 3.5cqw;
    line-height: 1.2;
    border: 1px solid #aac0d0;
  }

  .key-phase-hd {
    background: #c8dce8;
    color: #1a1a1a;
    font-size: 3.8cqw;
    font-weight: 700;
    text-align: center;
    padding: 0.6cqw 0.8cqw;
    border-bottom: 1px solid #aac0d0;
    line-height: 1.2;
  }

  .key-col-hds th {
    background: #e4eef5;
    color: #cc2200;
    font-size: 3.2cqw;
    font-weight: 700;
    text-align: left;
    padding: 0.5cqw 0.8cqw;
    border-bottom: 1px solid #aac0d0;
    line-height: 1.2;
  }

  .key-tbl tbody tr td {
    padding: 0.5cqw 0.8cqw;
    color: #1a1a1a;
    text-align: left;
    line-height: 1.2;
  }

  .row-white { background: #ffffff; }
  .row-yellow { background: #fffff0; }

  .lot-row {
    cursor: pointer;
    transition: background 120ms, color 120ms;
  }

  .lot-row:hover td {
    background: #d4e8f0 !important;
    color: #1a3a4a;
  }

  .lot-row td:last-child::after {
    content: ' ›';
    opacity: 0.3;
    transition: opacity 120ms;
    font-weight: 700;
    color: #2c7a9e;
  }

  .lot-row:hover td:last-child::after {
    opacity: 1;
  }

  /* Sold lots */
  .lot-row[data-status="sold"] td {
    text-decoration: line-through;
    color: #999 !important;
  }

  .lot-row[data-status="sold"]:hover td {
    background: inherit !important;
    color: #999 !important;
  }

  .lot-row[data-status="sold"] td:last-child::after {
    display: none;
  }

  /* Lot detail panel */
  .lot-panel-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.35);
    z-index: 200;
  }

  .lot-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 92vw);
    background: var(--color-cream);
    box-shadow: -4px 0 24px rgba(0,0,0,0.18);
    z-index: 201;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 320ms cubic-bezier(0.4, 0, 0.2, 1);
    overflow-y: auto;
  }

  .lot-panel[aria-hidden="false"] {
    transform: translateX(0);
  }

  .lot-panel-backdrop.open {
    display: block;
  }

  .lot-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: var(--space-6) var(--space-6) var(--space-4);
    border-bottom: 1px solid var(--color-olive-light);
    gap: var(--space-4);
    background: var(--color-cream-dark, #ECEAE0);
  }

  .lot-panel-phase {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-olive);
    margin: 0 0 var(--space-1);
  }

  .lot-panel-title {
    font-size: var(--text-2xl);
    color: var(--color-charcoal);
    margin: 0;
  }

  .lot-sold-badge {
    display: inline-block;
    margin-top: var(--space-2);
    background: #b02020;
    color: #fff;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 3px 10px;
    border-radius: 3px;
  }

  .lot-panel-close {
    background: none;
    border: 1px solid var(--color-olive-light);
    border-radius: 50%;
    width: 32px;
    height: 32px;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    color: var(--color-charcoal-mid);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background var(--transition), color var(--transition);
  }

  .lot-panel-close:hover {
    background: var(--color-olive-light);
    color: var(--color-charcoal);
  }

  .lot-panel-body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    flex: 1;
  }

  /* Photo gallery */
  .lot-panel-photos {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .lot-panel-photos:empty { display: none; }

  :global(.photo-strip) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  :global(.photo-thumb) {
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    cursor: pointer;
    background: #e8e5d8;
  }

  :global(.photo-thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 200ms;
  }

  :global(.photo-thumb:hover img) { transform: scale(1.04); }

  :global(.photo-thumb-label) {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.6));
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 10px 5px 5px;
    line-height: 1;
    text-align: center;
    pointer-events: none;
  }

  /* Lightbox */
  .lot-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.92);
    z-index: 300;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .lot-lightbox.open { display: flex; }

  .lot-lightbox-img-wrap {
    position: relative;
    max-width: min(90vw, 900px);
    max-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lot-lightbox-img-wrap img {
    max-width: 100%;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 4px;
    display: block;
  }

  .lot-lightbox-label {
    color: #fff;
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
    text-align: center;
    min-height: 1.2em;
    width: min(90vw, 900px);
  }

  .lot-lightbox-counter {
    color: rgba(255,255,255,0.5);
    font-size: var(--text-xs);
  }

  .lot-lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255,255,255,0.12);
    border: none;
    color: #fff;
    font-size: 24px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 150ms;
    flex-shrink: 0;
  }

  .lot-lightbox-nav:hover { background: rgba(255,255,255,0.25); }
  .lot-lightbox-nav.prev { left: -56px; }
  .lot-lightbox-nav.next { right: -56px; }

  .lot-lightbox-close {
    position: fixed;
    top: var(--space-5);
    right: var(--space-5);
    background: rgba(255,255,255,0.1);
    border: none;
    color: #fff;
    font-size: 22px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 150ms;
  }

  .lot-lightbox-close:hover { background: rgba(255,255,255,0.25); }

  .lot-panel-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-3);
  }

  :global(.lot-panel-stat) {
    background: #ffffff;
    border: 1px solid var(--color-olive-light);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    text-align: center;
  }

  :global(.lot-panel-stat-label) {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-charcoal-light);
    margin: 0 0 var(--space-1);
  }

  :global(.lot-panel-stat-value) {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-charcoal);
    margin: 0;
  }

  .lot-panel-desc {
    font-size: var(--text-base);
    color: var(--color-charcoal-mid);
    line-height: 1.7;
    margin: 0;
  }

  .lot-panel-cta {
    display: block;
    text-align: center;
    background: var(--color-olive);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius);
    transition: background var(--transition);
    margin-top: auto;
  }

  .lot-panel-cta:hover {
    background: var(--color-olive-dark);
  }

  .key-footer {
    font-size: 2.8cqw;
    color: #444;
    text-align: center;
    width: 100%;
    flex-shrink: 0;
    margin-top: 0.5cqw;
  }

  .plat-caption {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    text-align: center;
    margin: 0;
  }


  /* Agents */
  .agents-block {
    display: flex;
    align-items: flex-start;
    gap: var(--space-16);
  }

  .agents-text h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .agents-firm {
    font-weight: 500;
    font-size: var(--text-md);
    color: var(--color-charcoal);
    margin-bottom: var(--space-1);
  }

  .agents-text p {
    color: var(--color-charcoal-mid);
    font-size: var(--text-sm);
    margin: 0;
  }

  .agents-list {
    display: flex;
    gap: var(--space-8);
    flex-wrap: wrap;
  }

  .agent-card {
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-olive-light);
    border-radius: var(--radius);
    background: var(--color-cream-dark);
  }

  .agent-name {
    font-weight: 500;
    font-size: var(--text-sm);
    color: var(--color-charcoal);
    margin-bottom: var(--space-1);
  }

  .agent-card a {
    font-size: var(--text-sm);
    color: var(--color-charcoal-mid);
    text-decoration: none;
    transition: color var(--transition);
  }

  .agent-card a:hover {
    color: var(--color-olive);
  }

  /* CTA band */
  .cta-band {
    background: var(--color-cream-dark);
    border-top: 1px solid var(--color-olive-light);
  }

  .cta-band p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: var(--space-6);
  }

  .cta-buttons {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .agents-block {
      flex-direction: column;
      gap: var(--space-8);
    }
  }
</style>

<script define:vars={{ homesitesData }}>
  // ── Panel ──────────────────────────────────────────
  const panel    = document.getElementById('lot-panel');
  const backdrop = document.getElementById('lot-panel-backdrop');
  const closeBtn = document.getElementById('panel-close');

  // ── Lightbox ───────────────────────────────────────
  const lightbox      = document.getElementById('lot-lightbox');
  const lbImg         = document.getElementById('lightbox-img');
  const lbLabel       = document.getElementById('lightbox-label');
  const lbCounter     = document.getElementById('lightbox-counter');
  const lbClose       = document.getElementById('lightbox-close');
  const lbPrev        = document.getElementById('lightbox-prev');
  const lbNext        = document.getElementById('lightbox-next');
  let lbPhotos = [];
  let lbIndex  = 0;

  function lbShow(index) {
    lbIndex = (index + lbPhotos.length) % lbPhotos.length;
    const p = lbPhotos[lbIndex];
    lbImg.src     = p.file;
    lbImg.alt     = p.view || '';
    lbLabel.textContent   = p.view ? `${p.view} View` : '';
    lbCounter.textContent = `${lbIndex + 1} / ${lbPhotos.length}`;
    lbPrev.style.display = lbPhotos.length > 1 ? '' : 'none';
    lbNext.style.display = lbPhotos.length > 1 ? '' : 'none';
  }

  function openLightbox(photos, startIndex) {
    lbPhotos = photos;
    lbShow(startIndex);
    lightbox.classList.add('open');
    lbClose.focus();
  }

  function closeLightbox() {
    lightbox.classList.remove('open');
  }

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', () => lbShow(lbIndex - 1));
  lbNext.addEventListener('click', () => lbShow(lbIndex + 1));
  lightbox.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });

  // ── Panel ──────────────────────────────────────────
  function buildPhotoStrip(photos) {
    const el = document.getElementById('panel-photos');
    if (!photos || !photos.length) { el.innerHTML = ''; return; }

    el.innerHTML = `<div class="photo-strip">${photos.map((p, i) => `
      <div class="photo-thumb" data-index="${i}" tabindex="0" role="button" aria-label="${p.view ? p.view + ' view' : 'Lot photo ' + (i+1)}">
        <img src="${p.file}" alt="${p.view ? p.view + ' view' : ''}" loading="lazy" />
        ${p.view ? `<span class="photo-thumb-label">${p.view} View</span>` : ''}
      </div>
    `).join('')}</div>`;

    el.querySelectorAll('.photo-thumb').forEach(thumb => {
      const idx = parseInt(thumb.dataset.index);
      const open = () => openLightbox(photos, idx);
      thumb.addEventListener('click', open);
      thumb.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
    });
  }

  function openPanel(lotId) {
    const lot = homesitesData.find(l => l.id === lotId);
    if (!lot) return;

    document.getElementById('panel-phase').textContent = `Phase ${lot.phase}`;
    document.getElementById('panel-title').textContent = lot.lot;

    const soldBadge = document.getElementById('panel-sold-badge');
    if (lot.status === 'sold') {
      soldBadge.style.display = '';
    } else {
      soldBadge.style.display = 'none';
    }
    document.getElementById('panel-cta').href = `/contact?lot=${encodeURIComponent(lot.lot)}`;

    const desc = document.getElementById('panel-desc');
    desc.textContent  = lot.description || '';
    desc.style.display = lot.description ? 'block' : 'none';

    document.getElementById('panel-stats').innerHTML = `
      <div class="lot-panel-stat">
        <p class="lot-panel-stat-label">Acreage</p>
        <p class="lot-panel-stat-value">${Number(lot.acres).toFixed(2)}</p>
      </div>
      <div class="lot-panel-stat">
        <p class="lot-panel-stat-label">Price</p>
        <p class="lot-panel-stat-value">$${lot.price.toLocaleString()}</p>
      </div>
      <div class="lot-panel-stat">
        <p class="lot-panel-stat-label">Status</p>
        <p class="lot-panel-stat-value">${lot.status.charAt(0).toUpperCase() + lot.status.slice(1)}</p>
      </div>
    `;

    buildPhotoStrip(lot.photos || []);

    panel.setAttribute('aria-hidden', 'false');
    backdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closePanel() {
    panel.setAttribute('aria-hidden', 'true');
    backdrop.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.lot-row').forEach(row => {
    row.addEventListener('click', () => openPanel(row.dataset.lotId));
  });

  closeBtn.addEventListener('click', closePanel);
  backdrop.addEventListener('click', closePanel);

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      if (lightbox.classList.contains('open')) { closeLightbox(); return; }
      closePanel();
    }
    if (lightbox.classList.contains('open')) {
      if (e.key === 'ArrowLeft')  lbShow(lbIndex - 1);
      if (e.key === 'ArrowRight') lbShow(lbIndex + 1);
    }
  });
</script>
