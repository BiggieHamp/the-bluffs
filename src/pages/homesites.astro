---
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTable from '../components/PricingTable.astro';
import homesitesData from '../data/homesites.json';

const phase1  = homesitesData.filter(l => l.phase === 1);
const phase2  = homesitesData.filter(l => l.phase === 2);
const phase3  = homesitesData.filter(l => l.phase === 3);
---

<BaseLayout
  title="Available Homes & Homesites | The Bluffs — Overlooking Weiss Lake"
  description="Available lots at The Bluffs on Weiss Lake, Cedar Bluff, Alabama. Homesites from the $30s across Phase 1–3. Custom homes starting in the mid-$500s."
  image="/assets/images/pages/plat-map.jpg"
>

  <!-- PAGE HEADER -->
  <section class="section page-header">
    <div class="container-narrow text-center">
      <h1>Available Homes &amp; Homesites</h1>
      <p class="page-intro">
        Homesites available across three phases, each with water views and access to
        the full community. Custom homes starting in the mid-$500s.
      </p>
    </div>
  </section>

  <!-- PLAT MAP — cropped to show only the map area (table hidden) -->
  <section class="section-sm plat-section">
    <div class="container">
      <h2 class="section-heading">Property Map</h2>
      <div class="plat-map-crop">
        <img
          src="/assets/images/pages/plat-map.jpg"
          alt="Plat map of The Bluffs, showing Phase 1–3 lots on the Weiss Lake peninsula, Cedar Bluff, Cherokee County, Alabama"
          width="830"
          height="1170"
          loading="lazy"
          class="plat-img"
        />
      </div>
      <p class="plat-caption">
        The Bluffs — Overlooking Weiss Lake, Cedar Bluff, Cherokee County, Alabama.
        Click a lot below to view details.
      </p>
    </div>
  </section>

  <!-- INTERACTIVE LOT KEY -->
  <section class="section-sm lot-key-section">
    <div class="container">
      <h2 class="section-heading">Available Lots</h2>
      <p class="key-intro">Click any lot to view photos, acreage, pricing, and description.</p>

      <div class="lot-key-grid">

        <!-- Phase 1 -->
        <div class="lot-phase-block">
          <div class="phase-header">Phase 1</div>
          <table class="lot-table">
            <thead>
              <tr><th>Lot</th><th>Acres</th><th>Price</th></tr>
            </thead>
            <tbody>
              {phase1.map(lot => (
                <tr
                  class:list={['lot-row', { 'lot-row--available': lot.status === 'available' }]}
                  data-lot-id={lot.id}
                  role="button"
                  tabindex={lot.status === 'available' ? '0' : undefined}
                  aria-label={`View details for ${lot.lot}`}
                >
                  <td class="lot-num">{lot.lot}</td>
                  <td>{lot.acres} ac</td>
                  <td>{lot.price ? `$${lot.price.toLocaleString()}` : 'Contact us'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Phase 2 -->
        <div class="lot-phase-block">
          <div class="phase-header">Phase 2</div>
          <table class="lot-table">
            <thead>
              <tr><th>Lot</th><th>Acres</th><th>Price</th></tr>
            </thead>
            <tbody>
              {phase2.map(lot => (
                <tr
                  class:list={['lot-row', { 'lot-row--available': lot.status === 'available' }]}
                  data-lot-id={lot.id}
                  role="button"
                  tabindex={lot.status === 'available' ? '0' : undefined}
                  aria-label={`View details for ${lot.lot}`}
                >
                  <td class="lot-num">{lot.lot}</td>
                  <td>{lot.acres} ac</td>
                  <td>{lot.price ? `$${lot.price.toLocaleString()}` : 'Contact us'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <!-- Phase 3 -->
        <div class="lot-phase-block">
          <div class="phase-header">Phase 3</div>
          <table class="lot-table">
            <thead>
              <tr><th>Lot</th><th>Acres</th><th>Price</th></tr>
            </thead>
            <tbody>
              {phase3.map(lot => (
                <tr
                  class:list={['lot-row', { 'lot-row--available': lot.status === 'available' }]}
                  data-lot-id={lot.id}
                  role="button"
                  tabindex={lot.status === 'available' ? '0' : undefined}
                  aria-label={`View details for ${lot.lot}`}
                >
                  <td class="lot-num">{lot.lot}</td>
                  <td>{lot.acres} ac</td>
                  <td>{lot.price ? `$${lot.price.toLocaleString()}` : 'Contact us'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

      </div>
    </div>
  </section>

  <!-- LOT DETAIL PANEL -->
  <aside class="lot-panel" id="lot-panel" aria-label="Lot details" aria-hidden="true">
    <div class="lot-panel-head">
      <div>
        <p class="panel-phase" id="panel-phase"></p>
        <h3 class="panel-title" id="panel-title"></h3>
      </div>
      <button class="panel-close" id="panel-close" aria-label="Close lot details">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <div class="panel-photos" id="panel-photos"></div>
    <div class="panel-stats">
      <div class="panel-stat">
        <span class="panel-stat-label">Acreage</span>
        <span class="panel-stat-value" id="panel-acres"></span>
      </div>
      <div class="panel-stat">
        <span class="panel-stat-label">List Price</span>
        <span class="panel-stat-value" id="panel-price"></span>
      </div>
      <div class="panel-stat">
        <span class="panel-stat-label">Status</span>
        <span class="panel-stat-value" id="panel-status"></span>
      </div>
    </div>
    <p class="panel-desc" id="panel-desc"></p>
    <a href="/contact" class="btn btn-primary panel-cta" id="panel-cta">Contact Us About This Lot</a>
  </aside>
  <div class="lot-panel-backdrop" id="lot-panel-backdrop"></div>

  <hr class="divider" style="max-width: var(--max-width); margin: 0 auto;" />

  <!-- LISTING AGENTS -->
  <section class="section-sm agents-section">
    <div class="container">
      <div class="agents-block">
        <div class="agents-text">
          <h2>Listed With</h2>
          <p class="agents-firm">Maximum One Alabama Realtors</p>
          <p>Cedar Bluff, Alabama</p>
        </div>
        <div class="agents-list">
          <div class="agent-card">
            <p class="agent-name">Sandy Cole, Realtor</p>
            <p><a href="tel:+17705005159">(770) 500-5159</a></p>
          </div>
          <div class="agent-card">
            <p class="agent-name">Jennifer Black, Realtor</p>
            <p><a href="tel:+14702146196">(470) 214-6196</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-sm cta-band">
    <div class="container text-center">
      <p>Ready to find your lot?</p>
      <div class="cta-buttons">
        <a href="/contact" class="btn btn-primary">Contact Us</a>
        <a href="/gallery/lots-5-6" class="btn btn-outline">View Lots 5 &amp; 6 Photos</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Page header ── */
  .page-header {
    border-bottom: 1px solid var(--color-olive-light);
    padding-bottom: var(--space-10);
  }
  .page-header h1 { margin-bottom: var(--space-4); }
  .page-intro { font-size: var(--text-md); color: var(--color-charcoal-mid); margin: 0; }

  .section-heading { font-size: var(--text-xl); margin-bottom: var(--space-3); color: var(--color-charcoal); }

  /* ── Plat map — crops the bottom ~42% of the image to hide the baked-in table ──
     The image is 830×1170. The table starts at ~y=695 (59%). We show
     roughly the top 58%, which is 830:679 aspect ratio. */
  .plat-map-crop {
    border-radius: var(--radius);
    border: 1px solid var(--color-olive-light);
    overflow: hidden;
    /* Aspect ratio 830:679 — shows roughly the top 58% of the image */
    aspect-ratio: 830 / 679;
  }

  .plat-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .plat-caption {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    text-align: center;
    margin: var(--space-3) 0 0;
  }

  /* ── Interactive lot key ── */
  .lot-key-section {
    background: var(--color-cream-dark);
    border-top: 1px solid var(--color-olive-light);
    border-bottom: 1px solid var(--color-olive-light);
  }

  .key-intro {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    margin-bottom: var(--space-6);
  }

  .lot-key-grid {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .lot-phase-block {
    background: var(--color-cream);
    border: 1px solid var(--color-olive-light);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .phase-header {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-white);
    background: var(--color-charcoal);
    padding: var(--space-3) var(--space-4);
  }

  .lot-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .lot-table th {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-charcoal-light);
    background: var(--color-cream-dark);
    padding: var(--space-2) var(--space-4);
    text-align: left;
    border-bottom: 1px solid var(--color-olive-light);
  }

  .lot-table td {
    padding: var(--space-2) var(--space-4);
    color: var(--color-charcoal);
    border-bottom: 1px solid rgba(140,137,100,0.1);
  }

  .lot-num {
    font-weight: 500;
  }

  .lot-row {
    transition: background 100ms ease;
  }

  .lot-row--available {
    cursor: pointer;
  }

  .lot-row--available:hover {
    background: var(--color-olive-light);
  }

  .lot-row--available:focus {
    outline: 2px solid var(--color-olive);
    outline-offset: -2px;
  }

  /* ── Lot detail panel ── */
  .lot-panel {
    position: fixed;
    top: var(--nav-height);
    right: 0;
    bottom: 0;
    width: 360px;
    background: var(--color-cream);
    border-left: 1px solid var(--color-olive-light);
    box-shadow: -4px 0 24px rgba(0,0,0,0.10);
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 300ms ease;
    z-index: 200;
    display: flex;
    flex-direction: column;
  }

  .lot-panel.open { transform: translateX(0); }

  .lot-panel-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(28, 28, 26, 0.35);
    z-index: 199;
  }
  .lot-panel-backdrop.open { display: block; }

  .lot-panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-olive-light);
    position: sticky;
    top: 0;
    background: var(--color-cream);
    z-index: 1;
  }

  .panel-phase {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-olive);
    margin-bottom: var(--space-1);
  }

  .panel-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--color-charcoal);
  }

  .panel-close {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-charcoal-light);
    padding: var(--space-1);
    flex-shrink: 0;
    margin-top: 2px;
    transition: color var(--transition);
  }
  .panel-close:hover { color: var(--color-charcoal); }

  .panel-photos {
    width: 100%;
    min-height: 180px;
    background: var(--color-cream-dark);
    overflow: hidden;
    display: flex;
    gap: 2px;
  }

  .panel-photos img {
    flex: 1;
    min-width: 0;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .panel-photo-placeholder {
    width: 100%;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-charcoal-light);
    font-size: var(--text-sm);
    font-style: italic;
  }

  .panel-stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-bottom: 1px solid var(--color-olive-light);
  }

  .panel-stat {
    padding: var(--space-4) var(--space-5);
    border-right: 1px solid var(--color-olive-light);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .panel-stat:last-child { border-right: none; }

  .panel-stat-label {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-charcoal-light);
  }

  .panel-stat-value {
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--color-charcoal);
  }

  .panel-desc {
    padding: var(--space-5) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-charcoal-mid);
    line-height: 1.8;
    border-bottom: 1px solid var(--color-olive-light);
  }

  .panel-cta {
    margin: var(--space-6);
    text-align: center;
  }

  /* ── Agents ── */
  .agents-block { display: flex; align-items: flex-start; gap: var(--space-16); }
  .agents-text h2 { font-size: var(--text-xl); margin-bottom: var(--space-3); }
  .agents-firm { font-weight: 500; font-size: var(--text-md); color: var(--color-charcoal); margin-bottom: var(--space-1); }
  .agents-text p { color: var(--color-charcoal-mid); font-size: var(--text-sm); margin: 0; }
  .agents-list { display: flex; gap: var(--space-8); flex-wrap: wrap; }
  .agent-card { padding: var(--space-5) var(--space-6); border: 1px solid var(--color-olive-light); border-radius: var(--radius); background: var(--color-cream-dark); }
  .agent-name { font-weight: 500; font-size: var(--text-sm); color: var(--color-charcoal); margin-bottom: var(--space-1); }
  .agent-card a { font-size: var(--text-sm); color: var(--color-charcoal-mid); text-decoration: none; transition: color var(--transition); }
  .agent-card a:hover { color: var(--color-olive); }

  /* ── CTA band ── */
  .cta-band { background: var(--color-cream-dark); border-top: 1px solid var(--color-olive-light); }
  .cta-band p { font-family: var(--font-display); font-size: var(--text-xl); margin-bottom: var(--space-6); }
  .cta-buttons { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }

  /* ── Responsive ── */
  @media (max-width: 860px) {
    .lot-key-grid {
      grid-template-columns: 1fr 1fr;
    }
    /* Phase 2 spans both columns */
    .lot-phase-block:nth-child(2) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .lot-key-grid { grid-template-columns: 1fr; }
    .lot-phase-block:nth-child(2) { grid-column: auto; }

    .lot-panel {
      width: 100%;
      top: auto;
      bottom: 0;
      right: 0;
      left: 0;
      height: 75vh;
      transform: translateY(100%);
      border-left: none;
      border-top: 1px solid var(--color-olive-light);
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .lot-panel.open { transform: translateY(0); }
  }

  @media (max-width: 800px) {
    .agents-block { flex-direction: column; gap: var(--space-8); }
  }
</style>

<script define:vars={{ homesitesData }}>
  const lots = {};
  homesitesData.forEach(lot => { lots[lot.id] = lot; });

  const panel    = document.getElementById('lot-panel');
  const backdrop = document.getElementById('lot-panel-backdrop');
  const closeBtn = document.getElementById('panel-close');

  const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const statusLabel = { available: 'Available', sold: 'Sold', contract: 'Under Contract' };

  function openPanel(lotId) {
    const lot = lots[lotId];
    if (!lot) return;

    document.getElementById('panel-phase').textContent = `Phase ${lot.phase}`;
    document.getElementById('panel-title').textContent = lot.lot;
    document.getElementById('panel-acres').textContent = `${lot.acres} ac`;
    document.getElementById('panel-price').textContent = lot.price ? fmt.format(lot.price) : 'Contact us';

    const statusEl = document.getElementById('panel-status');
    statusEl.textContent = statusLabel[lot.status] || lot.status;

    const photosEl = document.getElementById('panel-photos');
    const photos = lot.photos || [];
    photosEl.innerHTML = photos.length
      ? photos.map(src => `<img src="${src}" alt="${lot.lot}" loading="lazy" />`).join('')
      : `<div class="panel-photo-placeholder">Photos coming soon</div>`;

    const descEl = document.getElementById('panel-desc');
    descEl.textContent = lot.description || '';
    descEl.style.display = lot.description ? '' : 'none';

    document.getElementById('panel-cta').href = `/contact?lot=${encodeURIComponent(lot.lot)}`;

    panel.classList.add('open');
    panel.setAttribute('aria-hidden', 'false');
    backdrop.classList.add('open');
    closeBtn.focus();
  }

  function closePanel() {
    panel.classList.remove('open');
    panel.setAttribute('aria-hidden', 'true');
    backdrop.classList.remove('open');
  }

  document.querySelectorAll('.lot-row--available').forEach(row => {
    row.addEventListener('click', () => openPanel(row.dataset.lotId));
    row.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openPanel(row.dataset.lotId); }
    });
  });

  closeBtn.addEventListener('click', closePanel);
  backdrop.addEventListener('click', closePanel);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closePanel(); });
</script>
