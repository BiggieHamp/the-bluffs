---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Visit Us | The Bluffs — Overlooking Weiss Lake"
  description="Visit The Bluffs in Cedar Bluff, Alabama. Open Monday–Friday, 10am–6pm. Located at County Road 767, Cedar Bluff, AL 35959."
>

  <!-- PAGE HEADER -->
  <section class="section page-header">
    <div class="container-narrow text-center">
      <h1>Visit Us</h1>
      <p class="page-intro">
        We'd love to show you The Bluffs in person. Come walk the trails, see the lake,
        and find the homesite that's right for you.
      </p>
    </div>
  </section>

  <!-- VISIT INFO + MAP -->
  <section class="section-sm visit-section">
    <div class="container">
      <div class="visit-grid">

        <!-- Info column -->
        <div class="visit-info">
          <div class="info-block">
            <h2>Location</h2>
            <address class="visit-address">
              <p>The Bluffs</p>
              <p>County Road 767</p>
              <p>Cedar Bluff, AL 35959</p>
            </address>
          </div>

          <div class="info-block">
            <h2>Hours</h2>
            <p>Monday – Friday</p>
            <p class="hours-time">10:00 am – 6:00 pm</p>
            <p class="hours-note">Tours available by appointment — contact us to arrange a visit outside regular hours.</p>
          </div>

          <div class="info-block">
            <h2>Phone</h2>
            <p><a href="tel:+14044216946" class="phone-link">(404) 421-6946</a></p>
            <p class="phone-name">John &amp; Patsy Hyatt</p>
          </div>

          <div class="info-block">
            <h2>Listing Agents</h2>
            <p class="agent-firm">Maximum One Alabama Realtors</p>
            <p>Cedar Bluff, AL</p>
            <div class="agent-list">
              <div class="agent">
                <p class="agent-name">Sandy Cole</p>
                <p><a href="tel:+17705005159">(770) 500-5159</a></p>
              </div>
              <div class="agent">
                <p class="agent-name">Jennifer Black</p>
                <p><a href="tel:+14702146196">(470) 214-6196</a></p>
              </div>
            </div>
          </div>

          <a href="/contact" class="btn btn-primary visit-cta">Send a Message</a>
        </div>

        <!-- Map column -->
        <div class="visit-map">
          <div class="map-wrapper">
            <iframe
              src="https://maps.google.com/maps?q=County+Road+767+Cedar+Bluff+AL+35959&output=embed&z=13"
              title="Map showing the location of The Bluffs on County Road 767, Cedar Bluff, Alabama"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
            ></iframe>
          </div>
          <p class="map-caption">
            <a
              href="https://maps.google.com/maps?q=County+Road+767+Cedar+Bluff+AL+35959"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in Google Maps ↗
            </a>
          </p>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .page-header {
    border-bottom: 1px solid var(--color-olive-light);
    padding-bottom: var(--space-10);
  }

  .page-header h1 {
    margin-bottom: var(--space-4);
  }

  .page-intro {
    font-size: var(--text-md);
    color: var(--color-charcoal-mid);
    margin: 0;
  }

  /* Two-column layout */
  .visit-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  /* Info column */
  .info-block {
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-olive-light);
  }

  .info-block:last-of-type {
    border-bottom: none;
  }

  .info-block h2 {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-olive);
    margin-bottom: var(--space-3);
    font-family: var(--font-body);
  }

  .visit-address {
    font-style: normal;
    line-height: 1.9;
    color: var(--color-charcoal-mid);
  }

  .hours-time {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-charcoal);
    margin: var(--space-1) 0 var(--space-3);
  }

  .hours-note {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    line-height: 1.6;
    margin: 0;
  }

  .phone-link {
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-charcoal);
    text-decoration: none;
    transition: color var(--transition);
  }

  .phone-link:hover {
    color: var(--color-olive);
  }

  .phone-name {
    font-size: var(--text-sm);
    color: var(--color-charcoal-light);
    margin-top: var(--space-1);
    margin-bottom: 0;
  }

  .agent-firm {
    font-weight: 500;
    color: var(--color-charcoal);
    margin-bottom: var(--space-1);
  }

  .agent-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .agent-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-charcoal);
    margin-bottom: var(--space-1);
  }

  .agent a {
    color: var(--color-charcoal-mid);
    text-decoration: none;
    transition: color var(--transition);
    font-size: var(--text-sm);
  }

  .agent a:hover {
    color: var(--color-olive);
  }

  .visit-cta {
    margin-top: var(--space-4);
    width: 100%;
    text-align: center;
  }

  /* Map */
  .map-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 62%;
    height: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--color-olive-light);
  }

  .map-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .map-caption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    text-align: right;
  }

  .map-caption a {
    color: var(--color-olive-dark);
    text-decoration: none;
    transition: color var(--transition);
  }

  .map-caption a:hover {
    color: var(--color-charcoal);
  }

  @media (max-width: 860px) {
    .visit-grid {
      grid-template-columns: 1fr;
    }

    .visit-map {
      order: -1;
    }

    .map-wrapper {
      padding-bottom: 56%;
    }
  }
</style>
