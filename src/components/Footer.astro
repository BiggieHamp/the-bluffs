---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-grid">

      <div class="footer-col">
        <p class="footer-label">Developers</p>
        <address class="footer-address">
          <p>John and Patsy Hyatt</p>
          <p>The Bluffs, County Road 767</p>
          <p>Cedar Bluff, AL 35959</p>
          <p><a href="tel:+14044216946">(404) 421-6946</a></p>
          <p><a href="mailto:johnwhyatt@bellsouth.net">johnwhyatt@bellsouth.net</a></p>
        </address>
      </div>

      <div class="footer-col">
        <p class="footer-label">Builder &amp; Developer</p>
        <address class="footer-address">
          <p>Wade Chappell</p>
          <p>Chappell Construction Group</p>
          <p><a href="tel:+14049649554">(404) 964-9554</a></p>
          <p><a href="mailto:wade@chappellcg.com">wade@chappellcg.com</a></p>
        </address>
      </div>

      <div class="footer-col footer-col-right">
        <a href="/" class="footer-logo" aria-label="The Bluffs — Home">
          <img
            src="/assets/images/logo.jpg"
            alt="The Bluffs — Overlooking Weiss Lake"
            width="140"
            height="42"
          />
        </a>
        <div class="footer-social">
          <a
            href="https://www.instagram.com/bluffsofweiss/"
            aria-label="Follow The Bluffs on Instagram"
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://www.facebook.com/TheBluffsofWeiss/"
            aria-label="Follow The Bluffs on Facebook"
            class="footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
        <a href="/contact" class="btn btn-outline footer-cta">Contact Us</a>
      </div>

    </div>

    <div class="footer-bottom">
      <p class="footer-credit">Photos Provided by Buvette &amp; Hasbrouck House</p>
      <p class="footer-copy">&copy; {year} The Bluffs — Overlooking Weiss Lake. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-cream);
    color: var(--color-charcoal-mid);
    border-top: 1px solid var(--color-olive-light);
    margin-top: auto;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-16) var(--space-6) var(--space-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-12);
    margin-bottom: var(--space-12);
  }

  .footer-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-olive);
    margin-bottom: var(--space-3);
  }

  .footer-address {
    font-style: normal;
    line-height: 1.8;
    font-size: var(--text-sm);
  }

  .footer-address a {
    color: var(--color-charcoal-mid);
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-address a:hover {
    color: var(--color-charcoal);
  }

  .footer-col-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .footer-logo img {
    opacity: 0.9;
    transition: opacity var(--transition);
  }

  .footer-logo:hover img {
    opacity: 1;
  }

  .footer-social {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .footer-social-link {
    color: var(--color-charcoal-light);
    display: flex;
    text-decoration: none;
    transition: color var(--transition);
  }

  .footer-social-link:hover {
    color: var(--color-charcoal);
  }

  .footer-cta {
    color: var(--color-olive);
    border-color: var(--color-olive);
    font-size: var(--text-xs);
    padding: var(--space-2) var(--space-5);
  }

  .footer-cta:hover {
    background: var(--color-olive);
    color: var(--color-white);
  }

  .footer-bottom {
    border-top: 1px solid var(--color-olive-light);
    padding-top: var(--space-6);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .footer-credit,
  .footer-copy {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
    margin: 0;
    letter-spacing: 0.02em;
  }

  @media (max-width: 800px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-col-right {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-6);
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
