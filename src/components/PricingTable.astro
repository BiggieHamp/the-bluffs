---
import homesites from '../data/homesites.json';

const phases = [1, 2, 3];
const byPhase = (phase: number) => homesites.filter(lot => lot.phase === phase);

function formatPrice(price: number): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: 0,
  }).format(price);
}

function statusLabel(status: string): string {
  if (status === 'sold') return 'Sold';
  if (status === 'contract') return 'Under Contract';
  return 'Available';
}
---

<div class="pricing-wrap">
  {phases.map(phase => (
    <div class="pricing-phase">
      <h3 class="phase-heading">Phase {phase}</h3>
      <div class="table-scroll">
        <table class="pricing-table" aria-label={`Phase ${phase} lot pricing`}>
          <thead>
            <tr>
              <th scope="col">Lot</th>
              <th scope="col">Acreage</th>
              <th scope="col">Price</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            {byPhase(phase).map(lot => (
              <tr class:list={[`row-${lot.status}`]}>
                <td class="lot-number">{lot.lot}</td>
                <td>{lot.acres} ac.</td>
                <td class="lot-price">{formatPrice(lot.price)}</td>
                <td>
                  <span class:list={['badge', {
                    'badge-available': lot.status === 'available',
                    'badge-sold':      lot.status === 'sold',
                    'badge-contract':  lot.status === 'contract',
                  }]}>
                    {statusLabel(lot.status)}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))}

  <p class="pricing-footnote">
    Acreage approximate, subject to final survey. Revised 10-2025.
  </p>
</div>

<style>
  .pricing-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .phase-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-olive);
    margin-bottom: var(--space-3);
  }

  /* Horizontal scroll wrapper for narrow viewports */
  .table-scroll {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .pricing-table thead {
    background: var(--color-cream-dark);
    border-bottom: 2px solid var(--color-olive-light);
  }

  .pricing-table th {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-charcoal-light);
  }

  .pricing-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-olive-light);
    color: var(--color-charcoal-mid);
    vertical-align: middle;
  }

  .pricing-table tbody tr:last-child td {
    border-bottom: none;
  }

  .pricing-table tbody tr:hover {
    background: rgba(140, 137, 100, 0.05);
  }

  .lot-number {
    font-weight: 500;
    color: var(--color-charcoal);
  }

  .lot-price {
    font-weight: 500;
    color: var(--color-charcoal);
  }

  /* Sold rows — de-emphasized */
  .row-sold td {
    color: var(--color-charcoal-light);
    text-decoration-color: var(--color-charcoal-light);
  }

  .row-sold .lot-number,
  .row-sold .lot-price {
    color: var(--color-charcoal-light);
  }

  /* Footnote */
  .pricing-footnote {
    font-size: var(--text-xs);
    color: var(--color-charcoal-light);
    border-top: 1px solid var(--color-olive-light);
    padding-top: var(--space-4);
    margin: 0;
  }
</style>
